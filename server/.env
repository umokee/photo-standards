# Database connection.
DB_SOCKET_DIR=/run/postgresql
DB_USER=postgres
DB_PASS=postgres
DB_NAME=photo-standards

# Inspection runtime profile.
# Most alignment/YOLO-anchor thresholds are intentionally kept as safe code defaults.
# Override low-level INSPECTION_* variables only while debugging a specific case.
INSPECTION_ALIGNMENT_PROFILE=balanced
INSPECTION_DEBUG_PAYLOAD=true

# YOLO runtime.
YOLO_DEVICE=auto
YOLO_HALF=false

INSPECTION_VERIFICATION_MODE=alignment
