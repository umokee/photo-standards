{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "project": "node ../deploy/scripts/run-local.js",
    "docker:dev": "cd .. && docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "cd .. && docker compose -f docker-compose.dev.yml build",
    "docker:dev:recreate": "cd .. && COMPOSE_PROGRESS=plain BUILDKIT_PROGRESS=plain docker compose -f docker-compose.dev.yml up -d --force-recreate",
    "docker:dev:rebuild": "cd .. && docker compose -f docker-compose.dev.yml build server worker-cpu worker-gpu client && docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "cd .. && docker compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "cd .. && docker compose -f docker-compose.dev.yml down --rmi local && docker system prune -a --volumes -f",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "konva": "^10.2.0",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.13.1",
    "use-image": "^1.1.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
