# Copy this file to server/.env or use it as a systemd EnvironmentFile.
# Adjust database credentials, storage paths and device settings for the target server.

APP_NAME=PhotoStandards API
DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=photo-standards
# DB_SOCKET_DIR=/run/postgresql

STORAGE_ROOT=/opt/photo-standards-db/storage

INSPECTION_VERIFICATION_MODE=alignment
MAX_REALTIME_INSPECTIONS=2

YOLO_DEVICE=auto
YOLO_DEFAULT_IMGSZ=640
YOLO_HALF=false

SAM2_DEVICE=cpu
SAM2_ROOT=/opt/photo-standards-db/storage/weights
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_s.yaml
SAM2_CHECKPOINT=/opt/photo-standards-db/storage/weights/sam2.1_hiera_small.pt

ALIGNMENT_BACKEND=auto
ALIGNMENT_DEVICE=auto
ALIGNMENT_ORB_FALLBACK=true
ALIGNMENT_IDENTITY_SHORTCUT=true

TASK_RUNNER_ENABLED=true
TASK_RUNNER_FAIL_ACTIVE_ON_STARTUP=true
TASK_RUNNER_POLL_INTERVAL_SEC=1.0
TASK_RUNNER_CPU_CONCURRENCY=2
TASK_RUNNER_GPU_CONCURRENCY=2
TASK_RUNNER_TRAINING_CONCURRENCY=1
TASK_RUNNER_INSPECTION_CONCURRENCY=2
TASK_RUNNER_MODEL_IMPORT_CONCURRENCY=1
TASK_RUNNER_HEARTBEAT_TIMEOUT_SEC=900.0
TASK_RUNNER_SERVICE_MONITOR_INTERVAL_SEC=2.0
TASK_RUNNER_SERVICE_RESTART_DELAY_SEC=2.0
TASK_RUNNER_SERVICE_MAX_RESTART_DELAY_SEC=30.0
TASK_RUNNER_SERVICE_STOP_TIMEOUT_SEC=10.0
TASK_RUNNER_SERVICE_PARENT_CHECK_INTERVAL_SEC=3.0
TASK_RUNNER_SERVICE_HEARTBEAT_INTERVAL_SEC=3.0
TASK_RUNNER_SERVICE_HEARTBEAT_TIMEOUT_SEC=30.0
TASK_RUNNER_SERVICE_MEMORY_LIMIT_MB=0
TASK_RUNNER_SERVICE_MIN_FREE_MEMORY_MB=1024
TASK_RUNNER_SERVICE_CPU_LIMIT_PERCENT=95.0
TASK_RUNNER_SERVICE_RESOURCE_GRACE_TICKS=3
